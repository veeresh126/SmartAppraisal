@model IEnumerable<DL_SmartAppraisal.Entities.CaseStudy>

@{
    ViewData["Title"] = "View Case Study";
}

<div class="container mt-4">
    <h2>View Case-study</h2>

    <table class="table table-bordered text-center">
        <thead>
            <tr>
                <th>CSID</th>
                <th>Status</th>
                <th>Review</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="CaseStudy" asp-action="Review" asp-route-id="@item.CaseStudyId">
                                @item.CaseStudyId
                            </a>
                        </td>
                        <td>
                            @item.Status
                        </td>
                        <td>
                            <a asp-controller="CaseStudy"
                               asp-action="Review"
                               asp-route-id="@item.CaseStudyId"
                               class="text-primary text-decoration-underline fw-bold">
                                Review
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No case studies available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>