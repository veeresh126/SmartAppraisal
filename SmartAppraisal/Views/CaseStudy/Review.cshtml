@model DL_SmartAppraisal.Entities.CaseStudy

@{
    ViewData["Title"] = "Review Case Study";
}

<style>
    .review-container {
        width: 600px;
        margin: 30px auto;
        border: 2px solid #000;
        padding: 20px;
        background-color: #fff;
        font-family: Arial, sans-serif;
    }

    .header-row {
        display: flex;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .header-label {
        font-weight: bold;
        width: 120px;
        color: #002060;
        text-decoration: underline;
    }

    .header-content {
        flex: 1;
        border: 1px solid #999;
        min-height: 50px;
        padding: 8px;
        word-break: break-word;
    }

    .solutions-grid {
        display: grid;
        grid-template-columns: 80px 1fr 1fr;
        row-gap: 8px;
        column-gap: 15px;
        align-items: center;
        margin-bottom: 20px;
    }

    .comp-header {
        font-weight: bold;
        text-decoration: underline;
    }

    .comment-section {
        margin-top: 15px;
    }

    .comment-label {
        margin-bottom: 5px;
        font-size: 14px;
    }

    .asterisk {
        color: red;
        margin-right: 3px;
    }

    .comment-box {
        width: 100%;
        height: 70px;
        border: 1px solid #000;
        padding: 8px;
        box-sizing: border-box;
    }

    .submit-container {
        text-align: center;
        margin-top: 20px;
    }

    .submit-button {
        padding: 6px 35px;
        border: 2px solid #000;
        border-radius: 12px;
        background: #fff;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<div class="review-container">
    <form asp-controller="CaseStudy" asp-action="Review" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CaseStudyId" value="@Model.CaseStudyId" />

        <!-- CASE STUDY SECTION -->
        <div class="header-row">
            <div class="header-label">Case study</div>
            <div class="header-content">
                @Model.CaseStudyText
            </div>
        </div>

        <!-- SOLUTIONS & COMPETENCIES SECTION -->
        <div class="solutions-grid">
            <div></div>
            <div class="comp-header">Comp</div>
            <div></div>

            @if (Model.Solutions != null && Model.Solutions.Any())
            {
                @foreach (var solution in Model.Solutions.OrderBy(x => x.SolutionNumber))
                {
                    <div>Soln@(solution.SolutionNumber)</div>
                    <div>
                        @if (solution.Competencies != null && solution.Competencies.Any())
                        {
                            @string.Join(", ", solution.Competencies.Select(c => c.CompetencyName))
                        }
                    </div>
                    <div>@solution.SolutionText</div>
                }
            }
        </div>

        <!-- REVIEW COMMENT SECTION -->
        <div class="comment-section">
            <div class="comment-label">
                <span class="asterisk">*</span>Review comment
            </div>
            <textarea name="ReviewComment" class="comment-box" required>@Model.ReviewComment</textarea>
        </div>

        <!-- SUBMIT BUTTON -->
        <div class="submit-container">
            <button type="submit" class="submit-button">Submit</button>
        </div>
    </form>
</div>