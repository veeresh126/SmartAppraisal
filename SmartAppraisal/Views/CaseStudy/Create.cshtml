@model DL_SmartAppraisal.Entities.CaseStudy

@{
    ViewData["Title"] = "Create Case Study";
}

<div class="container mt-4">

    <h2>Create Case Study</h2>

    <form method="post" action="/CaseStudy/Create">

        <!-- Designation -->
        <div class="mb-3">
            <label for="Designation" class="form-label">
                Designation
            </label>

            <select id="Designation"
                    name="Designation"
                    class="form-control">

                <option value="">-- Select Designation --</option>

                <option value="Software Engineer">
                    Software Engineer
                </option>

                <option value="Senior Software Engineer">
                    Senior Software Engineer
                </option>

                <option value="Technical Lead">
                    Technical Lead
                </option>

                <option value="Manager">
                    Manager
                </option>

            </select>
        </div>


        <!-- Case Study -->
        <div class="mb-3">

            <label for="CaseStudyText" class="form-label">
                Case Study
            </label>

            <textarea id="CaseStudyText"
                      name="CaseStudyText"
                      class="form-control"
                      rows="5"
                      placeholder="Enter case study"></textarea>

        </div>


        <!-- Solutions -->
        <h4>Solutions</h4>

        <div class="mb-3">
            <label for="Solution1">Soln1</label>

            <input type="text"
                   id="Solution1"
                   name="Solutions[0].SolutionText"
                   class="form-control"
                   placeholder="Enter solution 1" />
        </div>


        <div class="mb-3">
            <label for="Solution2">Soln2</label>

            <input type="text"
                   id="Solution2"
                   name="Solutions[1].SolutionText"
                   class="form-control"
                   placeholder="Enter solution 2" />
        </div>


        <div class="mb-3">
            <label for="Solution3">Soln3</label>

            <input type="text"
                   id="Solution3"
                   name="Solutions[2].SolutionText"
                   class="form-control"
                   placeholder="Enter solution 3" />
        </div>


        <div class="mb-3">
            <label for="Solution4">Soln4</label>

            <input type="text"
                   id="Solution4"
                   name="Solutions[3].SolutionText"
                   class="form-control"
                   placeholder="Enter solution 4" />
        </div>


        <button type="submit" class="btn btn-success">
            SUBMIT
        </button>

    </form>

</div>