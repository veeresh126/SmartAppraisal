@model DL_SmartAppraisal.Entities.CaseStudy

@{
    ViewData["Title"] = "Create Case Study";
}

<div class="container mt-4">

    <div class="solution-section">

        <h4>Create Case Study</h4>

        <div class="form-group mb-3">
            <label for="DesignationId" class="form-label">Designation</label>
            <select id="DesignationId"
                    name="DesignationId"
                    class="form-control"
                    asp-items="ViewBag.Designations"
                    required>
                <option value="">-- Select Designation --</option>
                <option value="Software Engineer">Software Engineer</option>
                <option value="Team Lead">Team Lead</option>
                <option value="Project Manager">Project Manager</option>
                <option value="QA Engineer">QA Engineer</option>
                <option value="Senior Developer">Senior Developer</option>
            </select>
        </div>

        <form asp-controller="CaseStudy"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <!-- =========================
                 CASE STUDY
                 ========================= -->

            <div class="form-row">

                <label for="CaseStudyText">
                    Case Study
                </label>

                <input type="text"
                       id="CaseStudyText"
                       name="CaseStudyText"
                       class="form-control"
                       placeholder="Enter case study"
                       value="@Model?.CaseStudyText"
                       required />

            </div>


            <!-- =========================
                 SOLUTION 1
                 ========================= -->

            <div class="form-row">

                <label for="Solution1">
                    Soln1
                </label>

                <input type="text"
                       id="Solution1"
                       name="Solution1"
                       class="form-control"
                       placeholder="Enter Solution 1"
                       required />


                <label for="Competency1">
                    Comp
                </label>

                <input type="text"
                       id="Competency1"
                       name="Competency1"
                       class="form-control competency-input"
                       placeholder="Enter Competency 1"
                       required />

            </div>


            <!-- =========================
                 SOLUTION 2
                 ========================= -->

            <div class="form-row">

                <label for="Solution2">
                    Soln2
                </label>

                <input type="text"
                       id="Solution2"
                       name="Solution2"
                       class="form-control"
                       placeholder="Enter Solution 2"
                       required />


                <label for="Competency2">
                    Comp
                </label>

                <input type="text"
                       id="Competency2"
                       name="Competency2"
                       class="form-control competency-input"
                       placeholder="Enter Competency 2"
                       required />

            </div>


            <!-- =========================
                 SOLUTION 3
                 ========================= -->

            <div class="form-row">

                <label for="Solution3">
                    Soln3
                </label>

                <input type="text"
                       id="Solution3"
                       name="Solution3"
                       class="form-control"
                       placeholder="Enter Solution 3"
                       required />


                <label for="Competency3">
                    Comp
                </label>

                <input type="text"
                       id="Competency3"
                       name="Competency3"
                       class="form-control competency-input"
                       placeholder="Enter Competency 3"
                       required />

            </div>


            <!-- =========================
                 SOLUTION 4
                 ========================= -->

            <div class="form-row">

                <label for="Solution4">
                    Soln4
                </label>

                <input type="text"
                       id="Solution4"
                       name="Solution4"
                       class="form-control"
                       placeholder="Enter Solution 4"
                       required />


                <label for="Competency4">
                    Comp
                </label>

                <input type="text"
                       id="Competency4"
                       name="Competency4"
                       class="form-control competency-input"
                       placeholder="Enter Competency 4"
                       required />

            </div>


            <!-- =========================
                 VALIDATION MESSAGE
                 ========================= -->

            <div asp-validation-summary="All"
                 class="text-danger mt-3">
            </div>


            <!-- =========================
                 SUBMIT
                 ========================= -->

            <div class="submit-section mt-3">

                <button type="submit"
                        class="btn btn-success">

                    SUBMIT

                </button>


            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}