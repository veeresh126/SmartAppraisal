@model DL_SmartAppraisal.Entities.UserDetail

@{
    ViewData["Title"] = "Register User";
}

<div class="container mt-4">

    <h2>User Registration</h2>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">
                User ID
            </label>

            <input asp-for="UserId"
                   class="form-control" />

            <span asp-validation-for="UserId"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                User Name
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Mobile" class="form-label">
                Mobile
            </label>

            <input asp-for="Mobile"
                   class="form-control" />

            <span asp-validation-for="Mobile"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleId" class="form-label">
                Role
            </label>

            <select asp-for="RoleId"
                    class="form-select">

                <option value="">Select Role</option>
                <option value="1">Admin</option>
                <option value="2">HR</option>
                <option value="3">Employee</option>

            </select>

            <span asp-validation-for="RoleId"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Designation" class="form-label">
                Designation
            </label>

            <input asp-for="Designation"
                   class="form-control" />

            <span asp-validation-for="Designation"
                  class="text-danger">
            </span>
        </div>

        <div class="form-check mb-3">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label">
                Active
            </label>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>